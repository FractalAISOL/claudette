# Solana cluster: mainnet-beta or devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# RPC for reads and for building transactions (use a domain-restricted Helius key)
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Claudette program and game
NEXT_PUBLIC_PROGRAM_ID=727pxDqXaRPdAJwb5DW8LtXJHPyPH3yoYfNzPeymhLB5
NEXT_PUBLIC_GAME_ID=1
# Privy app id (wallet connect). Add the site's domains to the app's allowed origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Agent backend (no trailing slash)
NEXT_PUBLIC_API_URL=https://claudette-agent.up.railway.app
# Transparency
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/claudette
NEXT_PUBLIC_PROMPT_SHA256=
# Fallback model id shown if /state is unreachable
NEXT_PUBLIC_MODEL_ID=claude-opus-5-5
# Public site URL (used for social cards)
NEXT_PUBLIC_SITE_URL=https://claudette.help
# 1 = fake data, fake log stream, fake payments. No backend or program needed.
NEXT_PUBLIC_MOCK=0
# 1 = coming-soon teaser instead of the game (no wallet, no API, no SSE; works with zero backend)
NEXT_PUBLIC_COMING_SOON=0
# Optional, coming-soon only: ISO launch time for the live countdown. Unset = "SOON / 近日公開".
NEXT_PUBLIC_LAUNCH_AT=
