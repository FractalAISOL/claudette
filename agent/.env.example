# Postgres. Use a fresh database per game (the service refuses a DB that belongs to another game).
DATABASE_URL=postgres://localhost/claudette_dev

# Anthropic. Model and effort are pinned in src/config.ts, not here.
ANTHROPIC_API_KEY=

# Solana (Helius RPC)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CLUSTER=mainnet-beta
PROGRAM_ID=727pxDqXaRPdAJwb5DW8LtXJHPyPH3yoYfNzPeymhLB5
GAME_ID=1

# Agent key: either set AGENT_SECRET_KEY to the JSON byte array (Railway) or point AGENT_KEY_FILE at ../.keys/agent-sol.json (local default).
AGENT_SECRET_KEY=
# AGENT_KEY_FILE=../.keys/agent-sol.json

# Tuning (defaults shown)
COMMITMENT=confirmed
PRIORITY_MICROLAMPORTS=100000
POLL_MS=5000
MESSAGE_TIMEOUT_SEC=600
JUDGING_SAFETY_SEC=120
PORT=8080
